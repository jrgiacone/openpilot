diff --git a/openpilot/cereal/log.capnp b/openpilot/cereal/log.capnp
index 1eaaa30..0112c14 100644
--- a/openpilot/cereal/log.capnp
+++ b/openpilot/cereal/log.capnp
@@ -1214,6 +1214,13 @@ struct LongitudinalPlan @0xe00b5b3eba12876c {
 
   solverExecutionTime @35 :Float32;
 
+  # lead trajectories the MPC solved against (13 points at T_IDXS); only meaningful
+  # when MpcLeadTrajectory is on, otherwise these mirror the legacy kinematic extrapolation
+  leadTrajectoryX0 @40 :List(Float32);
+  leadTrajectoryV0 @41 :List(Float32);
+  leadTrajectoryX1 @42 :List(Float32);
+  leadTrajectoryV1 @43 :List(Float32);
+
   enum LongitudinalPlanSource {
     cruise @0;
     lead0 @1;
