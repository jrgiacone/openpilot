 openpilot/common/params_keys.h                |  1 +
 .../lib/longitudinal_mpc_lib/long_mpc.py      | 67 +++++++++++++++++--
 .../controls/lib/longitudinal_planner.py      | 12 +++-
 .../ui/mici/layouts/settings/developer.py     |  3 +
 .../sunnypilot/layouts/settings/developer.py  |  8 ++-
